  "authors": ["Venus Launcher"],
  "contact": {
    "homepage": "https://github.com/rponfee/Venus-Launcher",
    "sources": "https://github.com/rponfee/Venus-Launcher/tree/main/mod/venus-badge"
  },
  "license": "MIT",
  "icon": "assets/venusbadge/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.venuslauncher.badge.VenusBadge"]
  },
  "mixins": ["venusbadge.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-resource-loader-v0": "*",
    "minecraft": "1.20.1",
    "java": ">=17"
  }
}
