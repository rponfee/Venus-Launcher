{
  "name": "venus-launcher",
  "productName": "Venus Launcher",
  "version": "1.0.13",
  "description": "Venus Launcher - Launcher de Minecraft con Modrinth, Fabric, Forge, NeoForge, Quilt, OptiFine, Iris, servidores locales, amigos, Voice Chat y nube",
  "main": "src/main/main.js",
  "author": "Venus Launcher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "release": "electron-builder --win --x64 --publish always",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "pidusage": "^4.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "venusUpdates": {
    "githubRepository": "rponfee/Venus-Launcher"
  },
  "build": {
    "appId": "com.venuslauncher.app",
    "productName": "Venus Launcher",
    "copyright": "Venus Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/**/test/**",
      "!src/**/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "venus.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "VenusLauncher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Venus Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "VenusLauncher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rponfee",
        "repo": "Venus-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
