{
  "name": "venus-launcher",
  "productName": "Venus Launcher",
  "version": "6.1.0",
  "description": "Venus Launcher",
  "main": "src/main/main.js",
  "author": "Venus Launcher",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "release": "electron-builder --win --x64 --publish always",
    "dist:mac": "electron-builder --mac --universal --publish never",
    "check": "node scripts/check.js",
    "mod:badge": "node scripts/build-badge-mod.js",
    "check:package": "node scripts/check-package.js",
    "smoke": "node scripts/smoke-packaged.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "pidusage": "^4.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "venusUpdates": {
    "githubRepository": "rponfee/Venus-Launcher"
  },
  "build": {
    "appId": "com.venuslauncher.app",
    "productName": "Venus Launcher",
    "copyright": "Venus Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/**/test/**",
      "!src/**/*.test.js",
      "!src/renderer/assets/wallpapers/manifest.json",
      "!src/renderer/assets/wallpapers/*.mp4",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "venus.ico"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "VenusLauncher-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Venus Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "VenusLauncher-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.games",
      "artifactName": "VenusLauncher-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "minimumSystemVersion": "12.0",
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Venus Launcher uses the microphone only for Voice Chat with your friends. / Venus Launcher usa el micrófono solo para el Voice Chat con tus amigos."
      },
      "protocols": [
        {
          "name": "Venus Launcher",
          "schemes": [
            "venus"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "VenusLauncher-mac.${ext}",
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rponfee",
        "repo": "Venus-Launcher",
        "releaseType": "release"
      }
    ]
  }
}
